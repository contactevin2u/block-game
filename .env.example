# Copy to .env for local runs. On Render, set these in the service's Environment tab instead.

PORT=3000
GAME_NAME=tetris.io
SESSION_DAYS=30

# Where players open the game, no trailing slash. Used in email links and payment return pages.
# Render-only setup: this server's address. Vercel + Render setup: the Vercel address.
BASE_URL=http://localhost:3000
# This server's own address, used for payment callbacks. Same as BASE_URL in a Render-only setup.
API_URL=http://localhost:3000
# Vercel + Render only: the front-end origins allowed to log in across sites (comma-separated).
CORS_ORIGIN=
# Optional: share the login cookie across subdomains of one custom domain, e.g. .yourgame.com
COOKIE_DOMAIN=

# Where the SQLite file lives. On Render use the disk: /data/game.db
DB_PATH=./data/game.db

# Email: console (dev, shows in the Test inbox), gmail (real, Gmail App Password), brevo (real, verified sender) or resend (real, needs a domain)
EMAIL_PROVIDER=console
GMAIL_USER=
GMAIL_APP_PASSWORD=
BREVO_API_KEY=
RESEND_API_KEY=
# For Brevo this must be the sender address you verified in Brevo.
EMAIL_FROM=tetris.io <you@example.com>

# Payments: mock (development only; refused on Render), none (purchases closed), ipay88 (ADAPTIS / iPay88) or chip
PAYMENT_PROVIDER=mock
# Safety switch. Buy buttons are hidden and orders refused until this is true. Leave off until a sandbox test passed.
PAYMENTS_ENABLED=false
# Re-check job for orders still pending: age before re-check, how often, and when to give up (milliseconds).
# PENDING_AGE_MS=900000
# RECHECK_INTERVAL_MS=300000
# PENDING_EXPIRE_MS=7200000
# iPay88 sandbox (leave unset for live): IPAY88_ENTRY_URL=https://sandbox.ipay88.com.my/epayment/entry.asp
#                                        IPAY88_REQUERY_URL=https://sandbox.ipay88.com.my/epayment/enquiry.asp
# iPay88: from the "MERCHANT KEY" email from iPay88 support. The game's address must be the website registered on the account.
IPAY88_MERCHANT_CODE=
IPAY88_MERCHANT_KEY=
# IPAY88_SIG_ALGO=sha256   (older accounts use sha1)
CHIP_BRAND_ID=
CHIP_SECRET_KEY=
# CHIP_API_BASE=https://gate.chip-in.asia/api/v1
